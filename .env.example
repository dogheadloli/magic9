# 复制为 .env 后填写（.env 勿提交 Git）
# cp .env.example .env

# ---- 镜像（Jenkins 部署时会覆盖 IMAGE_TAG）----
DOCKER_IMAGE=registry.example.com/stock-monitor
IMAGE_TAG=latest

# ---- 应用 ----
SERVER_PORT=8964
JAVA_OPTS=-Xms256m -Xmx512m -Duser.timezone=Asia/Shanghai

# ---- 数据库（本机 MySQL；容器内用 host.docker.internal 访问）----
# 本机直接跑 jar 时把 host 改成 localhost 即可
DB_URL=jdbc:mysql://host.docker.internal:3306/stock?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASS=

# ---- 邮件（不配则邮件渠道自动跳过）----
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_TO=

# ---- 企业微信（不配则企微渠道自动跳过）----
WECOM_KEY=

# ---- 币安现货（独立页面，默认开启）----
CRYPTO_ENABLED=true
# 国内访问不通时可换成 https://data-api.binance.vision
CRYPTO_BINANCE_BASE=https://api.binance.com

# ---- DeepSeek AI（可选）----
AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
