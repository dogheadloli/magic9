# 复制为 .env 后填写（.env 勿提交 Git）
# cp .env.example .env

# ---- 镜像（Jenkins 部署时会覆盖 IMAGE_TAG）----
DOCKER_IMAGE=registry.example.com/stock-monitor
IMAGE_TAG=latest

# ---- 应用 ----
SERVER_PORT=8964
JAVA_OPTS=-Xms256m -Xmx512m

# ---- 数据库（Compose 默认连宿主机 MySQL）----
DB_URL=jdbc:mysql://host.docker.internal:3306/stock?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASS=

# ---- 邮件（不配则邮件渠道自动跳过）----
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_TO=

# ---- 企业微信（不配则企微渠道自动跳过）----
WECOM_KEY=

# ---- DeepSeek AI（可选）----
AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
